// Phase-0 probe for Wokwi: connectivity route + training-speed measurement.
//
// 1. Joins Wokwi-GUEST, syncs NTP time.
// 2. GETs PROBE_URL/hello from the laptop (via Cloudflare quick tunnel or the
//    Wokwi Private Gateway) — proves the route.
// 3. Runs the demo MLP (64->32->6, plain SGD, batch 32) for BENCH_EPOCHS epochs
//    over 340 synthetic samples (same size as one HAR subject) and reports the
//    simulated time per epoch. It brackets the benchmark with GETs to
//    PROBE_URL/bench_start and /bench_end so the laptop also measures REAL
//    wall-clock time (Wokwi's millis() is simulated time).
//
// Set PROBE_URL to the address printed by demo/scripts/phase0_probe_server.py.

#include <WiFi.h>
#include <HTTPClient.h>
#include <WiFiClientSecure.h>
#include <time.h>
#include <Ed25519.h>   // rweather "Crypto" library (libraries.txt)
#include "vector.h"    // FinSentinel test vector (generated by gen_test_vectors.py)

#define PROBE_URL "https://REPLACE-WITH-TUNNEL-URL"   // current URL: demo/.state/tunnel_url.txt (changes often)
#define BENCH_EPOCHS 3

static const int NF = 64, NH = 32, NC = 6, NS = 340, BATCH = 32;
static float W1[NH][NF], b1v[NH], W2[NC][NH], b2v[NC];
static float gW1[NH][NF], gB1[NH], gW2[NC][NH], gB2[NC];
// Samples stored as int8 (value * 127): 22 KB instead of 87 KB of float, which
// would not fit in static DRAM next to WiFi. HAR features are already in [-1, 1].
static int8_t Xq[NS][NF];
static const float XS = 1.0f / 127.0f;
#define X(s, i) (Xq[s][i] * XS)
static uint8_t Y[NS];

static uint32_t rngState = 12345;
static float frand() {  // xorshift32 -> [-1, 1)
  rngState ^= rngState << 13; rngState ^= rngState >> 17; rngState ^= rngState << 5;
  return (rngState / 2147483648.0f) - 1.0f;
}

static bool httpGet(const String& path, String* body = nullptr) {
  String url = String(PROBE_URL) + path;
  uint32_t t0 = millis();
  HTTPClient http;
  int code;
  if (url.startsWith("https://")) {
    WiFiClientSecure tls;
    tls.setInsecure();  // probe only; the real firmware verifies the server
    http.begin(tls, url);
    code = http.GET();
    if (body && code > 0) *body = http.getString();
    http.end();
  } else {
    http.begin(url);
    code = http.GET();
    if (body && code > 0) *body = http.getString();
    http.end();
  }
  Serial.printf("GET %s -> %d (sim %lu ms)\n", url.c_str(), code, millis() - t0);
  return code == 200;
}

static float trainEpoch() {
  float h[NH], z[NH], p[NC], dz2[NC], dh[NH];
  float totalLoss = 0;
  for (int start = 0; start < NS; start += BATCH) {
    int end = min(start + BATCH, NS), bs = end - start;
    memset(gW1, 0, sizeof gW1); memset(gB1, 0, sizeof gB1);
    memset(gW2, 0, sizeof gW2); memset(gB2, 0, sizeof gB2);
    for (int s = start; s < end; s++) {
      for (int j = 0; j < NH; j++) {
        float a = b1v[j];
        for (int i = 0; i < NF; i++) a += W1[j][i] * X(s, i);
        z[j] = a; h[j] = a > 0 ? a : 0;
      }
      float mx = -1e30f;
      for (int c = 0; c < NC; c++) {
        float a = b2v[c];
        for (int j = 0; j < NH; j++) a += W2[c][j] * h[j];
        p[c] = a; if (a > mx) mx = a;
      }
      float sum = 0;
      for (int c = 0; c < NC; c++) { p[c] = expf(p[c] - mx); sum += p[c]; }
      for (int c = 0; c < NC; c++) p[c] /= sum;
      totalLoss += -logf(p[Y[s]] + 1e-12f);
      for (int c = 0; c < NC; c++) dz2[c] = (p[c] - (c == Y[s] ? 1.f : 0.f)) / bs;
      for (int j = 0; j < NH; j++) dh[j] = 0;
      for (int c = 0; c < NC; c++) {
        gB2[c] += dz2[c];
        for (int j = 0; j < NH; j++) { gW2[c][j] += dz2[c] * h[j]; dh[j] += W2[c][j] * dz2[c]; }
      }
      for (int j = 0; j < NH; j++) {
        float d = z[j] > 0 ? dh[j] : 0;
        gB1[j] += d;
        for (int i = 0; i < NF; i++) gW1[j][i] += d * X(s, i);
      }
    }
    const float lr = 0.05f;
    for (int j = 0; j < NH; j++) { b1v[j] -= lr * gB1[j]; for (int i = 0; i < NF; i++) W1[j][i] -= lr * gW1[j][i]; }
    for (int c = 0; c < NC; c++) { b2v[c] -= lr * gB2[c]; for (int j = 0; j < NH; j++) W2[c][j] -= lr * gW2[c][j]; }
  }
  return totalLoss / NS;
}

void setup() {
  Serial.begin(115200);
  Serial.println("\n[probe] start");
  WiFi.begin("Wokwi-GUEST", "", 6);
  uint32_t t0 = millis();
  int lastStatus = -1;
  while (WiFi.status() != WL_CONNECTED) {
    delay(250);
    int st = WiFi.status();
    if (st != lastStatus) { Serial.printf("[probe] WiFi status %d at %lu ms\n", st, millis() - t0); lastStatus = st; }
    if (millis() - t0 > 90000) { Serial.println("WiFi failed after 90 s"); return; }
  }
  Serial.printf("[probe] WiFi ok in %lu ms, IP %s\n", millis() - t0, WiFi.localIP().toString().c_str());

  configTime(0, 0, "pool.ntp.org", "time.google.com");
  struct tm tm; t0 = millis();
  while (!getLocalTime(&tm, 500)) { if (millis() - t0 > 20000) { Serial.println("NTP failed"); break; } }
  char ts[32]; strftime(ts, sizeof ts, "%Y-%m-%dT%H:%M:%SZ", &tm);
  Serial.printf("[probe] UTC time %s\n", ts);

  Serial.printf("[probe] arduino-esp32 %s, cpu %lu MHz\n", ESP_ARDUINO_VERSION_STR, (unsigned long)getCpuFrequencyMhz());

  // Ed25519 cross-check: sign FinSentinel's canonical envelope with the TEST key.
  uint8_t pub[32], sig[64];
  uint32_t k0 = millis();
  Ed25519::derivePublicKey(pub, TV_SEED);
  Ed25519::sign(sig, TV_SEED, pub, TV_CANONICAL, strlen(TV_CANONICAL));
  uint32_t signMs = millis() - k0;
  bool sigOk = memcmp(sig, TV_SIGNATURE, 64) == 0 && memcmp(pub, TV_PUBKEY, 32) == 0;
  Serial.printf("[probe] ed25519 sign %s (sim %lu ms)\n", sigOk ? "MATCHES FinSentinel vector" : "MISMATCH", signMs);

  String body;
  httpGet("/ed25519?match=" + String(sigOk ? 1 : 0) + "&sim_ms=" + String(signMs));
  bool ok = httpGet("/hello?board=probe&t=" + String(ts), &body);
  Serial.printf("[probe] route %s: %s\n", ok ? "OK" : "FAILED", body.c_str());

  for (int j = 0; j < NH; j++) { b1v[j] = frand() * 0.1f; for (int i = 0; i < NF; i++) W1[j][i] = frand() * 0.125f; }
  for (int c = 0; c < NC; c++) { b2v[c] = frand() * 0.1f; for (int j = 0; j < NH; j++) W2[c][j] = frand() * 0.18f; }
  for (int s = 0; s < NS; s++) { Y[s] = s % NC; for (int i = 0; i < NF; i++) { float v = frand() * 0.8f + (i % NC == Y[s] ? 0.2f : 0.f); Xq[s][i] = (int8_t)lroundf(v * 127.0f); } }

  httpGet("/bench_start?epochs=" + String(BENCH_EPOCHS));
  uint32_t b0 = millis();
  for (int e = 0; e < BENCH_EPOCHS; e++) {
    uint32_t e0 = millis();
    float loss = trainEpoch();
    Serial.printf("[probe] epoch %d loss %.4f sim_ms %lu\n", e + 1, loss, millis() - e0);
  }
  uint32_t simMs = millis() - b0;
  httpGet("/bench_end?epochs=" + String(BENCH_EPOCHS) + "&sim_ms=" + String(simMs));
  Serial.printf("[probe] DONE: %d epochs, simulated %lu ms (%.1f ms/epoch)\n", BENCH_EPOCHS, simMs, simMs / (float)BENCH_EPOCHS);
}

void loop() { delay(1000); }
