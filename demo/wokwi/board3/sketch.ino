// FL demo board firmware (Wokwi-simulated ESP32, arduino-esp32 3.3.x).
//
// Protocol: demo/docs/PROTOCOL.md. Wire format reference: demo/fldemo/wire.py.
// Files in this folder (all generated by demo/scripts/gen_firmware.py):
//   board_config.h   board id / label / subject     (committed)
//   board_secrets.h  device seed, coordinator key, beacon topic (GITIGNORED)
//   board_data.h     this board's HAR subject as int8 in flash (committed)
//   ca_roots.h       public root CAs for TLS (from certifi)
//   fl_app.h         the application (WiFi, beacon, round flow, OLED, controls)
//   fl_*.h           pure C++ model / NPZ / JSON / base64 / SHA-256 (host-tested)
//
// Round flow: poll /fl/round every 5 s -> download + verify the signed model ->
// train on local data -> NPZ + Ed25519-signed envelope -> POST /api/v1/updates
// (FinSentinel) -> POST /fl/report. Status telemetry on every state change.

// Library includes are repeated here so the Arduino builder discovers them.
#include <WiFi.h>
#include <WiFiClientSecure.h>
#include <HTTPClient.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <Adafruit_MPU6050.h>
#include <Adafruit_Sensor.h>
#include <Ed25519.h>
#include "fl_app.h"

void setup() { app_setup(); }

void loop() { app_loop(); }
